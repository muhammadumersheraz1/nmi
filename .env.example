# NMI Merchant Sign-Up API (sandbox) — used by the browser sample (Vite envPrefix NMI_)
# Docs: https://docs.nmi.com/reference/sign-up-api
NMI_BASE_URL=https://sandbox.signup.nmi.com/api/v1
NMI_CLIENT_ID=replace_me
NMI_CLIENT_SECRET=replace_me
NMI_SCOPE=*

# Partner key (merchant management, reports, user management)
NMI_PARTNER_API_KEY=replace_me

# Optional fallback package id
# NMI_DEFAULT_PACKAGE_ID=pkg_merrick_tsys

# Optional fallbacks — prefer Merchants → Generate keys (session vault)
# NMI_MERCHANT_API_KEY=
# NMI_PUBLIC_API_KEY=

# Optional webhook.cool inbox (Sign-Up portal URL). Receiver is not part of Vite-only mode.
# NMI_WEBHOOK_PUBLIC_URL=https://your-inbox.webhook.cool
# NMI_WEBHOOK_SECRET=
